# ---- Servidor ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Orígenes permitidos para CORS (separados por coma). Usa * para permitir todos.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Base de datos (PostgreSQL en Supabase) ----
# Este backend es un servidor Express persistente (no serverless), así que la conexión
# directa alcanza para DATABASE_URL y DIRECT_URL. Si en el futuro escalas a funciones
# serverless, cambia DATABASE_URL por la cadena de "Connection pooling" (puerto 6543).
# Panel del proyecto Supabase -> Project Settings -> Database -> Connection string.
DATABASE_URL="postgresql://postgres:TU_PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:TU_PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# ---- Supabase Data API (opcional: solo si además usas el SDK supabase-js) ----
# Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# ---- Autenticación (JWT) ----
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambia-esto-por-otro-secreto-distinto
JWT_REFRESH_EXPIRES_IN=7d

# ---- Inteligencia Artificial (Groq) ----
# Consigue tu API key en https://console.groq.com/keys
GROQ_API_KEY=tu-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# ---- Seguridad ----
BCRYPT_ROUNDS=10

# ---- Datos del super administrador que crea el seed ----
SEED_ADMIN_NAME=Administrador General
SEED_ADMIN_EMAIL=admin@emprendesmart.com
SEED_ADMIN_PASSWORD=Admin123*
