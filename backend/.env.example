# ---- Servidor ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Orígenes permitidos para CORS (separados por coma). Usa * para permitir todos.
# :3000/:5173 -> panel admin (Next.js/Vite). :8765 -> build web de la app móvil Flutter
# (flutter run -d chrome --web-port=8765, o sirviendo `flutter build web` con ese puerto).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8765

# ---- Base de datos (PostgreSQL en Supabase) ----
# Este backend es un servidor Express persistente (no serverless), así que la conexión
# directa alcanza para DATABASE_URL y DIRECT_URL. Si en el futuro escalas a funciones
# serverless, cambia DATABASE_URL por la cadena de "Connection pooling" (puerto 6543).
# Panel del proyecto Supabase -> Project Settings -> Database -> Connection string.
DATABASE_URL="postgresql://postgres:TU_PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:TU_PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# ---- Supabase Data API (opcional: solo si además usas el SDK supabase-js) ----
# Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# ---- Autenticación (JWT) ----
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambia-esto-por-otro-secreto-distinto
JWT_REFRESH_EXPIRES_IN=7d

# ---- Inteligencia Artificial (Groq) ----
# Consigue tu API key en https://console.groq.com/keys
GROQ_API_KEY=tu-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# ---- Correo (Gmail, recomendado para demos) ----
# Envía a cualquier correo (~500/día). Requiere verificación en 2 pasos en la cuenta de Google y una
# contraseña de aplicación: https://myaccount.google.com/apppasswords  (tiene prioridad sobre Resend)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---- Correo (Resend) ----
# Para recuperar contraseña. Crea la API key en https://resend.com/api-keys
# Sin RESEND_API_KEY, en desarrollo el código se imprime en la consola del backend.
# Sin dominio verificado, onboarding@resend.dev solo entrega al email de tu cuenta de Resend.
RESEND_API_KEY=
MAIL_FROM=EmprendeSmart <onboarding@resend.dev>

# ---- Seguridad ----
BCRYPT_ROUNDS=10

# ---- Datos del super administrador que crea el seed ----
SEED_ADMIN_NAME=Administrador General
SEED_ADMIN_EMAIL=admin@emprendesmart.com
SEED_ADMIN_PASSWORD=Admin123*

# Firebase Auth (inicio de sesión con Google y SMS en la app móvil)
FIREBASE_PROJECT_ID=emprendesmart-75583
